# Public configuration: use the SAME installation for content and commerce.
VITE_WORDPRESS_API_URL=https://longlifedigital-zmuro.wpcomstaging.com/wp-json/wp/v2
VITE_WOOCOMMERCE_STORE_API_URL=https://longlifedigital-zmuro.wpcomstaging.com/wp-json/wc/store/v1
VITE_HEADLESS_COMMERCE=true

# Server only. Put local values in ignored .env.local; configure separately in Vercel.
# Generate a random secret of at least 32 characters; preserve it across restarts.
COMMERCE_SESSION_SECRET=
# Exact React origins allowed to POST. Add your actual Vercel preview/deployment origins.
STOREFRONT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Copy from WordPress Settings → General → Longlife headless checkout after plugin activation.
LLD_COMMERCE_BRIDGE_SECRET=
